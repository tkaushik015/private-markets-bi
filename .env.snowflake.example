# Copy to .env.snowflake.local (gitignored) and fill in. Nothing in this file is a real
# credential: the account, user and key path are blank on purpose.
#
#   cp .env.snowflake.example .env.snowflake.local
#   python infra/snowflake/load_raw.py --raw-dir data/raw --env-file .env.snowflake.local --stage-wheel
#   dbt build --project-dir warehouse --profiles-dir warehouse --target snowflake_dev

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=LP_LENS_TRANSFORMER_USER
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_ROLE=LP_LENS_TRANSFORMER
SNOWFLAKE_WAREHOUSE=LP_LENS_WH
SNOWFLAKE_DATABASE=LP_LENS_DEV
SNOWFLAKE_DATABASE_PROD=LP_LENS_PROD
SNOWFLAKE_ROLE_PROD=LP_LENS_TRANSFORMER

# dbt source schema. load_raw.py --raw-schema must match.
LP_LENS_RAW_SCHEMA=RAW

# snowflake_ci target only. generate_schema_name prefixes STAGING/INTERMEDIATE/MARTS with this.
LP_LENS_CI_SCHEMA=CI_LOCAL

# Stage path of the slim metrics wheel. Set after `load_raw.py --stage-wheel`.
# Object names, not an account identifier.
LP_LENS_SNOWPARK_WHEEL=@LP_LENS_DEV.RAW.LP_LENS_PACKAGES/lp_lens-0.1.0-py3-none-any.whl
