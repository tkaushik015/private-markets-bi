# ----------------------------------------------------------------------
# Secrets and machine-local overrides
# ----------------------------------------------------------------------
# Every credential reaches this project through an environment variable. Nothing
# below is ever committed; the tracked examples are the only exceptions.
.env*
!.env.example
!.env.snowflake.example
*.local.*
*.pem
*.p8
*.key

# ----------------------------------------------------------------------
# dbt
# ----------------------------------------------------------------------
target/
dbt_packages/
logs/
.user.yml

# ----------------------------------------------------------------------
# Power BI local state
# ----------------------------------------------------------------------
# Power BI Desktop writes these next to the PBIP. They are machine-local cache and
# per-user settings, not part of the artifact.
.pbi/localSettings.json
cache.abf

# ----------------------------------------------------------------------
# Generated data
# ----------------------------------------------------------------------
# The generator is seeded and deterministic, so raw Parquet and the local warehouse
# are always reproducible from source and do not belong in git.
data/raw/
data/warehouse/
#
# Exception: the published DuckDB file under data/published/ IS committed. Streamlit
# Community Cloud has no warehouse to reach, so the public deployment reads a
# snapshot from the repository. It holds synthetic data only.
!data/published/
!data/published/**

# ----------------------------------------------------------------------
# Python
# ----------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.venv/
venv/
ENV/

# ----------------------------------------------------------------------
# Tooling caches
# ----------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# ----------------------------------------------------------------------
# Editors and OS
# ----------------------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ----------------------------------------------------------------------
# Temporary
# ----------------------------------------------------------------------
tmp/
temp/
*.tmp
*.bak
*.log
