# ----------------------------------------------------------------------
# Secrets and machine-local overrides
# ----------------------------------------------------------------------
# Every credential reaches this project through an environment variable. Nothing
# below is ever committed; the tracked examples are the only exceptions.
.env*
!.env.example
!.env.snowflake.example
*.local.*
*.pem
*.p8
*.key

# ----------------------------------------------------------------------
# dbt
# ----------------------------------------------------------------------
target/
dbt_packages/
logs/
.user.yml

# ----------------------------------------------------------------------
# Power BI local state
# ----------------------------------------------------------------------
# Power BI Desktop writes these next to the PBIP. They are machine-local cache and
# per-user settings, not part of the artifact. Both patterns need the leading **/ because
# they live inside the .SemanticModel and .Report folders, not at the repository root.
# .pbi/editorSettings.json is deliberately not ignored: it is a shared project setting.
**/.pbi/localSettings.json
**/cache.abf

# ----------------------------------------------------------------------
# Generated data and local warehouses
# ----------------------------------------------------------------------
# The generator is seeded and deterministic, so raw Parquet and any DuckDB file built
# from it are reproducible from source and do not belong in git.
data/raw/
*.duckdb
*.duckdb.wal
# The Streamlit Community Cloud default is this committed synthetic warehouse so a
# public deploy can run without Snowflake or a local dbt build.
!app/data/demo.duckdb
#
# The warehouse directory's *contents* are ignored rather than the directory itself, so the
# .gitkeep below can be re-included. Git cannot re-include a file inside an excluded directory,
# only inside an excluded set of paths.
#
# The .gitkeep is tracked because sqlfluff's dbt templater opens a DuckDB connection in order to
# build the adapter, so linting needs this path to be openable even in a fresh clone that has not
# built anything yet. Only the .gitkeep is tracked; the database files are not.
data/warehouse/*
!data/warehouse/.gitkeep

# ----------------------------------------------------------------------
# Python
# ----------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.venv/
venv/
ENV/

# ----------------------------------------------------------------------
# Tooling caches
# ----------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# ----------------------------------------------------------------------
# Editors and OS
# ----------------------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ----------------------------------------------------------------------
# Temporary
# ----------------------------------------------------------------------
tmp/
temp/
*.tmp
*.bak
*.log
